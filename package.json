{
  "name": "sse-typewriter-demo",
  "version": "1.0.0",
  "description": "SSE streaming message demo with typewriter effect",
  "main": "server.js",
  "scripts": {
    "start": "node server/index.js",
    "start:legacy": "node server.js",
    "dev": "npm run start",
    "react": "cd react-chat && npm run dev",
    "all": "concurrently \"npm run start\" \"npm run react\"",
    "voice": "cd voice-service && python app.py",
    "voice:setup": "cd voice-service && pip install -r requirements.txt",
    "agent:demo": "node server/scripts/agent-loop-demo.js --mock",
    "install:all": "npm install && cd react-chat && npm install"
  },
  "keywords": [
    "sse",
    "streaming",
    "typewriter"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "sql.js": "^1.14.2"
  }
}
